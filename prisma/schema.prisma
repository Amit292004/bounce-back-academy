generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  class     String
  email     String   @unique
  mobile    String?
  password  String
  adSent      Boolean  @default(false)
  welcomeSent Boolean  @default(false)
  emailVerified Boolean  @default(false)
  otp           String?
  otpExpires    DateTime?
  image       String?
  createdAt   DateTime @default(now())
  likes       Like[]
  favorites   Favorite[]
}

model Admin {


  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  googleEmail String?  @unique
  createdAt   DateTime @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  papers    QuestionPaper[]
  notes     Note[]
  videos    Video[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique
  createdAt DateTime @default(now())
  papers    QuestionPaper[]
}

model QuestionPaper {
  id           String   @id @default(cuid())
  title        String
  className    String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  yearId       String
  year         AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  phase        String?
  viewUrl      String
  downloadFile String
  createdAt    DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
}

model Note {
  id           String   @id @default(cuid())
  title        String
  className    String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  viewUrl      String
  downloadFile String
  createdAt    DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
}

model Video {
  id          String   @id @default(cuid())
  title       String
  youtubeLink String
  category    String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  pdfUrl      String?
  createdAt   DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  className String
  message   String
  createdAt DateTime @default(now())
}

model Branding {
  id               String   @id @default(cuid())
  siteLogo         String?
  adminPhoto       String?
  whatsappMessage  String?
  whatsappImageUrl String?
  adMessage        String?
  adImageUrl       String?
  updatedAt        DateTime @updatedAt
}

model ActiveSession {
  id        String   @id @default(cuid())
  lastSeen  DateTime @default(now())
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String   // "VIDEO", "NOTE", "PAPER"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String   // "VIDEO", "NOTE", "PAPER"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType])
}
