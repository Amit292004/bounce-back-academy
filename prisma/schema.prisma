generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  class     String
  email     String   @unique
  mobile    String?
  password  String
  adSent      Boolean  @default(false)
  welcomeSent Boolean  @default(false)
  emailVerified Boolean  @default(false)
  otp           String?
  otpExpires    DateTime?
  image       String?
  createdAt   DateTime @default(now())
  likes       Like[]
  favorites   Favorite[]
  purchases   Purchase[]
}

model Admin {


  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  googleEmail String?  @unique
  createdAt   DateTime @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  papers    QuestionPaper[]
  notes     Note[]
  videos    Video[]
  chapters  Chapter[]
  quizzes   Quiz[]
}

model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String?
  caption   String?
  createdAt DateTime @default(now())
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique
  createdAt DateTime @default(now())
  papers    QuestionPaper[]
}

model QuestionPaper {
  id           String   @id @default(cuid())
  title        String
  className    String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  yearId       String?
  year         AcademicYear? @relation(fields: [yearId], references: [id], onDelete: Cascade)
  phase        String?
  viewUrl      String
  downloadFile String
  createdAt    DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
  chapterId    String?
  chapter      Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
}

model Note {
  id           String   @id @default(cuid())
  title        String
  className    String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  viewUrl      String
  downloadFile String
  createdAt    DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
  chapterId    String?
  chapter      Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
}

model Video {
  id          String   @id @default(cuid())
  title       String
  youtubeLink String
  category    String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  pdfUrl      String?
  createdAt   DateTime @default(now())
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  favoritesCount Int    @default(0)
  chapterId      String?
  chapter        Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  lectureNumber  Int      @default(0)
}

model Announcement {
  id        String   @id @default(cuid())
  message   String?
  imageUrl  String?
  type      String   @default("SECTION") // "BANNER" or "SECTION"
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  className String
  message   String
  createdAt DateTime @default(now())
}

model Branding {
  id               String   @id @default(cuid())
  siteLogo         String?
  adminPhoto       String?
  whatsappMessage  String?
  whatsappImageUrl String?
  adMessage        String?
  adImageUrl       String?
  updatedAt        DateTime @updatedAt
}

model ActiveSession {
  id        String   @id @default(cuid())
  lastSeen  DateTime @default(now())
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String   // "VIDEO", "NOTE", "PAPER"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String   // "VIDEO", "NOTE", "PAPER"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType])
}

model Chapter {
  id        String   @id @default(cuid())
  name          String
  number        Int       @default(0)
  className     String
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  notes     Note[]
  videos    Video[]
  papers    QuestionPaper[]
  createdAt DateTime @default(now())

  @@unique([name, className, subjectId])
}

model Quiz {
  id           String         @id @default(cuid())
  title        String
  className    String
  subjectId    String?
  subject      Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions    QuizQuestion[]
  createdAt    DateTime       @default(now())
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String?
  imageUrl     String?
  type         String   @default("TEXT") // "MCQ" or "TEXT"
  options      String?  // Pipe-separated MCQ options (e.g. "A|B|C|D")
  answer       String   // Correct answer to match against
  explanation  String?
  timeLimit    Int      @default(30)     // Custom time limit for this question in seconds
  createdAt    DateTime @default(now())
}

model PremiumItem {
  id            String      @id @default(cuid())
  title         String
  description   String
  type          String      // "NOTE" | "PYQ" | "COURSE" | "LECTURE"
  price         Float
  originalPrice Float?
  imageUrl      String?
  features      String?     // Pipe-separated feature highlights (e.g. "Direct PDF download | Live QA support")
  resourceId    String?     // Specific resource ID for redirection upon purchase
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  purchases     Purchase[]
  contents      PremiumContent[]
}

model Purchase {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  premiumItemId String
  premiumItem   PremiumItem @relation(fields: [premiumItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, premiumItemId])
}

model PremiumContent {
  id            String      @id @default(cuid())
  premiumItemId String
  premiumItem   PremiumItem @relation(fields: [premiumItemId], references: [id], onDelete: Cascade)
  contentType   String      // "NOTE" | "VIDEO" | "PAPER"
  title         String
  description   String?
  // For NOTE/PAPER
  viewUrl       String?     // Google Drive / PDF embed URL
  downloadUrl   String?     // Direct download link
  // For VIDEO
  youtubeLink   String?     // YouTube embed link
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
}

